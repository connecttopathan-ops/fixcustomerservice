{
  "name": "fix-cs-cx-ab",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Site files live in public/ so that wrangler.jsonc and .gitignore are
    // not uploaded as publicly fetchable URLs. Pointing this at "./" would
    // serve the homepage from /public/ and break every path on the site.
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
